{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#f2e5bc",
    "panel": "#ebdbb2",
    "element": "#d5c4a1",
    "muted": "#bdae93",
    "fg": "#504945",
    "fg2": "#665c54",
    "fg3": "#3c3836",
    "red": "#9d0006",
    "orange": "#af3a03",
    "yellow": "#b57614",
    "green": "#79740e",
    "aqua": "#427b58",
    "blue": "#076678",
    "purple": "#8f3f71",
    "add_bg": "#e2ecc4",
    "del_bg": "#f0d0c4"
  },
  "theme": {
    "primary": { "dark": "blue", "light": "blue" },
    "secondary": { "dark": "aqua", "light": "aqua" },
    "accent": { "dark": "yellow", "light": "yellow" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "orange", "light": "orange" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "fg", "light": "fg" },
    "textMuted": { "dark": "fg2", "light": "fg2" },
    "background": { "dark": "bg", "light": "bg" },
    "backgroundPanel": { "dark": "panel", "light": "panel" },
    "backgroundElement": { "dark": "element", "light": "element" },
    "border": { "dark": "element", "light": "element" },
    "borderActive": { "dark": "fg2", "light": "fg2" },
    "borderSubtle": { "dark": "muted", "light": "muted" },
    "diffAdded": { "dark": "aqua", "light": "aqua" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "fg2", "light": "fg2" },
    "diffHunkHeader": { "dark": "fg2", "light": "fg2" },
    "diffHighlightAdded": { "dark": "aqua", "light": "aqua" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "add_bg", "light": "add_bg" },
    "diffRemovedBg": { "dark": "del_bg", "light": "del_bg" },
    "diffContextBg": { "dark": "bg", "light": "bg" },
    "diffLineNumber": { "dark": "fg2", "light": "fg2" },
    "diffAddedLineNumberBg": { "dark": "add_bg", "light": "add_bg" },
    "diffRemovedLineNumberBg": { "dark": "del_bg", "light": "del_bg" },
    "markdownText": { "dark": "fg", "light": "fg" },
    "markdownHeading": { "dark": "blue", "light": "blue" },
    "markdownLink": { "dark": "blue", "light": "blue" },
    "markdownLinkText": { "dark": "aqua", "light": "aqua" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "fg2", "light": "fg2" },
    "markdownEmph": { "dark": "orange", "light": "orange" },
    "markdownStrong": { "dark": "fg3", "light": "fg3" },
    "markdownHorizontalRule": { "dark": "muted", "light": "muted" },
    "markdownListItem": { "dark": "blue", "light": "blue" },
    "markdownListEnumeration": { "dark": "aqua", "light": "aqua" },
    "markdownImage": { "dark": "blue", "light": "blue" },
    "markdownImageText": { "dark": "aqua", "light": "aqua" },
    "markdownCodeBlock": { "dark": "fg", "light": "fg" },
    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "red", "light": "red" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "fg", "light": "fg" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "purple", "light": "purple" },
    "syntaxType": { "dark": "yellow", "light": "yellow" },
    "syntaxOperator": { "dark": "fg2", "light": "fg2" },
    "syntaxPunctuation": { "dark": "fg2", "light": "fg2" }
