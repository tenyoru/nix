{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "anthropic",
    "openai"
  ],
  "instructions": [
    "/home/Tenyoru/notes/AGENTS.md"
  ],
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/Tenyoru/notes"
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "timeout": 120000
    },
    "nixos": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-nixos"
      ],
      "timeout": 120000
    },
    "yt-dlp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@kevinwatt/yt-dlp-mcp@latest"
      ]
    }
  }
}
