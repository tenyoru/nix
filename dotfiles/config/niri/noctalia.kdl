layout {

    focus-ring {
        active-color   "#c3caa3"
        inactive-color "#131411"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c3caa3"
        inactive-color "#131411"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#c3caa3"
        inactive-color "#2a2a27"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c3caa380"
    }
}

recent-windows {
    highlight {
        active-color "#c3caa3"
        urgent-color "#ffb4ab"
    }
}
